          <SourceLine>Session.kastalPage.MyMusicContainer.LockRight = true</SourceLine>
          <SourceLine>Session.kastalPage.MyMusicContainer.EmbedWithin(Session.kastalPage, 0, 56, Session.kastalPage.Width, Session.kastalPage.Height-86)//688)//Session.MyAccountPage.Height-60)</SourceLine>
          <SourceLine/>
          <SourceLine>else</SourceLine>
          <SourceLine>Session.kastalPage.MyMusicContainer.Visible=True</SourceLine>

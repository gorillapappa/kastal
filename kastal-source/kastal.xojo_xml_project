        <SourceLine>if b &lt; &amp;h80 or b &gt; &amp;hBF then exit for</SourceLine>
        <SourceLine>i = i+3</SourceLine>
        <SourceLine>case &amp;hF4</SourceLine>
        <SourceLine>// three additional bytes</SourceLine>

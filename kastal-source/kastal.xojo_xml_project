          <SourceLine>Sub Pressed()</SourceLine>
          <SourceLine>//Seems we can not have two preempting threads hammering the DB with writes at the same time, it will choke the DB.</SourceLine>
          <SourceLine>//So we prevent  this Scan4TunesThread to be started if the Scan4MoviesThread is running.</SourceLine>
          <SourceLine>if MyScan4MoviesThread&lt;&gt;nil then</SourceLine>
          <SourceLine>if MyScan4MoviesThread.ThreadState=Thread.ThreadStates.Running then</SourceLine>
          <SourceLine>MessageBox("Please wait untill the Movie folder scanning has completed")</SourceLine>
          <SourceLine>Return</SourceLine>
          <SourceLine>end if</SourceLine>
          <SourceLine>end if</SourceLine>
          <SourceLine/>
          <SourceLine>//Check if the path represents a folder</SourceLine>
          <SourceLine>Var f As New FolderItem(GetPrefsValue("MyMusicFolder"), FolderItem.PathModes.Shell)</SourceLine>
          <SourceLine/>
          <SourceLine>if MyScan4TunesThread = nil then</SourceLine>
          <SourceLine>MyScan4TunesThread = new MainModule.Scan4TunesThread</SourceLine>
          <SourceLine>MyScan4TunesThread.Type=Thread.Types.Preemptive</SourceLine>
          <SourceLine>end if</SourceLine>
          <SourceLine/>
          <SourceLine>if f &lt;&gt; nil then</SourceLine>
          <SourceLine>if f.Exists then</SourceLine>
          <SourceLine>if MyScan4TunesThread.ThreadState=Thread.ThreadStates.NotRunning then</SourceLine>
          <SourceLine>MyScan4TunesThread.run</SourceLine>
          <SourceLine>else</SourceLine>
          <SourceLine>MessageBox("There is a already a scan in progress")</SourceLine>
          <SourceLine>end if</SourceLine>
          <SourceLine>end if</SourceLine>
          <SourceLine>end if</SourceLine>
          <SourceLine/>
          <SourceLine>MusicScannerProgress.Visible=true</SourceLine>
          <SourceLine>End Sub</SourceLine>
        </ItemSource>
      </HookInstance>

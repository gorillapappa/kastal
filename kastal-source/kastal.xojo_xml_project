        <SourceLine>// System.DebugLog("TagText(" + tagText.Length.ToString + "):_BEG_'" + tagText + "'_END_   File:" + FileItem.Name)</SourceLine>
        <SourceLine>If tagText.Left(3) = "TAG" Then id3v1Exists = True</SourceLine>
        <SourceLine>If id3v1Exists Then </SourceLine>
        <SourceLine/>
        <SourceLine>Try</SourceLine>

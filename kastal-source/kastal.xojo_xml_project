      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Function BuildQuery(sortColumns as String, forCount as boolean) As String</SourceLine>
        <SourceLine>Var sql As String = "SELECT tblTunes.TuneID AS TuneID, tblTunes.Band AS Band , tblTunes.Album AS Album, tblTunes.Year AS Year, tblTunes.Title AS Title, tblTunes.Location AS Location FROM tblTunes"</SourceLine>
        <SourceLine>If forCount Then</SourceLine>
        <SourceLine>sql = "SELECT Count(*) AS c FROM tblTunes"</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>'sql1 = Session.kastalPage.MyMusicContainer.LibraryPopupMenu.RowTagAt(Session.kastalPage.MyMusicContainer.LibraryPopupMenu.SelectedRowIndex)</SourceLine>
        <SourceLine/>
        <SourceLine>if Session.PlaylistSQL&lt;&gt;"" then</SourceLine>
        <SourceLine>sql=sql+Session.PlaylistSQL</SourceLine>
        <SourceLine>end if</SourceLine>
        <SourceLine/>
        <SourceLine>If filter &lt;&gt; ""  Then</SourceLine>
        <SourceLine/>
        <SourceLine>if Session.PlaylistSQL="" then</SourceLine>
        <SourceLine>sql=sql+" WHERE"</SourceLine>
        <SourceLine>else</SourceLine>
        <SourceLine>sql=sql+" AND"</SourceLine>
        <SourceLine>end if</SourceLine>
        <SourceLine/>
        <SourceLine>select case Session.what</SourceLine>
        <SourceLine>case 0</SourceLine>
        <SourceLine>sql = sql + " (Band LIKE ? OR Album LIKE ? OR Title LIKE ?)"</SourceLine>
        <SourceLine>case 1</SourceLine>
        <SourceLine>sql = sql + " Band LIKE ?"</SourceLine>
        <SourceLine>case 2</SourceLine>
        <SourceLine>sql = sql + " Album LIKE ?"</SourceLine>
        <SourceLine>case 3</SourceLine>
        <SourceLine>sql = sql + " Title LIKE ?"</SourceLine>
        <SourceLine>end select</SourceLine>
        <SourceLine>end if</SourceLine>
        <SourceLine/>
        <SourceLine>'If sortColumns &lt;&gt; "" Then</SourceLine>
        <SourceLine>sql = sql + " ORDER BY Band, Album, Title"// COLLATE NORMALIZE"// + sortColumns</SourceLine>
        <SourceLine>'End If</SourceLine>
        <SourceLine/>
        <SourceLine>Return sql</SourceLine>
        <SourceLine>End Function</SourceLine>

      <PartID>693002239</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub SetupDB()</SourceLine>
        <SourceLine>MyDB.ExecuteSQL("PRAGMA journal_mode=WAL;")</SourceLine>
        <SourceLine>MyDB.ExecuteSQL("PRAGMA encoding = ""UTF-8"";")</SourceLine>
        <SourceLine>MyDB.ExecuteSQL("CREATE TABLE tblUsers (userID INTEGER PRIMARY KEY AUTOINCREMENT, creationDate TEXT, State INTEGER, Email TEXT, Password TEXT, liCookie TEXT, FirstName TEXT, LastName TEXT,  Adr1 TEXT, Adr2 TEXT,  PostalCode TEXT, City TEXT, Country TEXT, Phone TEXT, uURL TEXT)")</SourceLine>
        <SourceLine>MyDB.ExecuteSQL("CREATE TABLE tblTunes (TuneID INTEGER PRIMARY KEY AUTOINCREMENT, Band TEXT, Album TEXT, Title TEXT, tracknum TEXT, Year TEXT, Hearts INTEGER, Location TEXT NOT NULL UNIQUE)")</SourceLine>
        <SourceLine>MyDB.ExecuteSQL("CREATE TABLE tblMovies (MovieID INTEGER PRIMARY KEY AUTOINCREMENT, Title TEXT, meta TEXT, Year TEXT, Hearts INTEGER, Location TEXT NOT NULL UNIQUE)")</SourceLine>
        <SourceLine>MyDB.ExecuteSQL("CREATE TABLE tblPlaylists (playlistID INTEGER PRIMARY KEY AUTOINCREMENT, user_ID INTEGER, Type  INTEGER, playlistName TEXT, playlistDescription TEXT, playlistMeta TEXT)")</SourceLine>
        <SourceLine>MyDB.ExecuteSQL("CREATE TABLE tblPlaylistTunes (playlist_ID INTEGER, tune_ID  INTEGER, sortorder INTEGER)")</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>

      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Function RowData(row as integer) As String()</SourceLine>
        <SourceLine>Var sql As String = BuildQuery(mLastSortColumns, False)</SourceLine>
        <SourceLine>sql = sql + " LIMIT 1 OFFSET " + Str(row)</SourceLine>
        <SourceLine/>
        <SourceLine>Var rs as RowSet</SourceLine>
        <SourceLine>If filter = "" Then</SourceLine>
        <SourceLine>rs = db.SelectSQL(sql)</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>'if Session.what&gt;0 then</SourceLine>
        <SourceLine>rs = db.SelectSQL(sql, "%" + filter + "%")</SourceLine>
        <SourceLine>'else</SourceLine>
        <SourceLine>'if what&gt;0 then</SourceLine>
        <SourceLine>'rs = db.SelectSQL(sql, "%" + filter + "%")</SourceLine>
        <SourceLine>'else</SourceLine>
        <SourceLine>'rs = db.SelectSQL(sql, "%" + filter + "%", "%" + filter + "%", "%" + filter + "%")</SourceLine>
        <SourceLine>'end if</SourceLine>
        <SourceLine>'end if</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>Dim datum() As String</SourceLine>
        <SourceLine>If Not rs.AfterLastRow then</SourceLine>
        <SourceLine>datum.Add rs.Column("Movies").StringValue</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>rs.Close</SourceLine>
        <SourceLine/>
        <SourceLine>Return datum</SourceLine>
        <SourceLine>End Function</SourceLine>
      </ItemSource>
      <TextEncoding>134217984</TextEncoding>

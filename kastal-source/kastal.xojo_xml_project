        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Function RowCount() As Integer</SourceLine>
        <SourceLine>// Part of the WebDataSource interface.</SourceLine>
        <SourceLine/>
        <SourceLine>// Typically you would ask your data source how many rows are in the current query</SourceLine>
        <SourceLine>// If you're applying a filter of some sort, you should apply it here too.</SourceLine>
        <SourceLine/>
        <SourceLine>Try</SourceLine>
        <SourceLine>Var sql As String = BuildQuery("", true)</SourceLine>
        <SourceLine>Var rs As RowSet</SourceLine>
        <SourceLine>If filter = "" Then</SourceLine>
        <SourceLine>rs = db.SelectSQL(sql)</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>'if what&gt;0 then</SourceLine>
        <SourceLine>rs = db.SelectSQL(sql, "%" + filter + "%")</SourceLine>
        <SourceLine>'else</SourceLine>
        <SourceLine>'rs = db.SelectSQL(sql, "%" + filter + "%", "%" + filter + "%", "%" + filter + "%")</SourceLine>
        <SourceLine>'end if</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>Var c As Integer = rs.Column("c").IntegerValue</SourceLine>
        <SourceLine>rs.Close</SourceLine>
        <SourceLine>Return c</SourceLine>
        <SourceLine>Catch ex As DatabaseException</SourceLine>
        <SourceLine/>
        <SourceLine>End Try</SourceLine>
        <SourceLine/>
        <SourceLine>Return 0</SourceLine>
        <SourceLine>End Function</SourceLine>

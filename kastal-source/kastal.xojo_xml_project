    <Method>
      <ItemName>GetCleanUTFText</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>1353488383</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Function GetCleanUTFText(thisString As String) As String</SourceLine>
        <SourceLine>Var tmpText As String = EncodeHex(thisString)</SourceLine>
        <SourceLine>tmpText = tmpText.ReplaceAll("EFBFBD","") // EFBFBD is the UTF-8 representation of an unknown character</SourceLine>
        <SourceLine>Do Until tmpText.Right(2)&lt;&gt;"00" // Strip NULL characters from end of UTF text</SourceLine>
        <SourceLine>tmpText = tmpText.Left( tmpText.Length - 2 )</SourceLine>
        <SourceLine>Loop</SourceLine>
        <SourceLine>Return DecodeHex(tmpText)</SourceLine>
        <SourceLine>Exception</SourceLine>
        <SourceLine>End Function</SourceLine>
      </ItemSource>
      <TextEncoding>134217984</TextEncoding>
      <AliasName/>
      <ItemFlags>33</ItemFlags>
      <IsShared>0</IsShared>
      <ItemParams>thisString As String</ItemParams>
      <ItemResult>String</ItemResult>

        <Compatibility/>
        <Visible>1</Visible>
        <PartID>1885192191</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub SelectionChanged(rows() As Integer)</SourceLine>
          <SourceLine>'MyDB.ExecuteSQL("CREATE TABLE tblPlaylistTunes (playlist_ID INTEGER, tune_ID  INTEGER, sortorder INTEGER)")</SourceLine>
          <SourceLine>if me.SelectedRowIndex&gt;=0 then</SourceLine>
          <SourceLine>addTunetoPlaylist(Session.kastalPage.MyMusicContainer.TunesListBox.RowTagAt(Session.kastalPage.MyMusicContainer.TunesListBox.SelectedRowIndex), me.RowTagAt(me.SelectedRowIndex))</SourceLine>
          <SourceLine>me.SelectedRowIndex=-1</SourceLine>
          <SourceLine>me.parent.Close</SourceLine>
          <SourceLine>end if</SourceLine>
          <SourceLine>End Sub</SourceLine>
        </ItemSource>
      </HookInstance>

          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub Pressed()</SourceLine>
          <SourceLine>Var sql as String</SourceLine>
          <SourceLine>Var d As DateTime = DateTime.Now</SourceLine>
          <SourceLine/>
          <SourceLine>if uID.Text="" then //Add new user</SourceLine>
          <SourceLine/>
          <SourceLine>//Here we store the innitialuser in the DB</SourceLine>
          <SourceLine>sql = "INSERT INTO tblUsers (Email, creationDate, State, Password, FirstName, LastName) VALUES(?, ?, ?, ?, ?, ?)"</SourceLine>
          <SourceLine>Try</SourceLine>
          <SourceLine>MyDB.ExecuteSQL(sql, EmailFld.Text, d.SQLDateTime, myStatePopup.RowTagAt(myStatePopup.SelectedRowIndex).IntegerValue, PasswordHash(EmailFld.Text+PWFld.text,512), "User", "Name")</SourceLine>
          <SourceLine>Catch error As DatabaseException</SourceLine>
          <SourceLine>MessageBox( "DB Error " + error.Message)</SourceLine>
          <SourceLine>Return</SourceLine>
          <SourceLine>End Try</SourceLine>
          <SourceLine/>
          <SourceLine>else //Save current user</SourceLine>
          <SourceLine/>
          <SourceLine>sql = "UPDATE tblUsers SET State = ? WHERE userID = ?"</SourceLine>
          <SourceLine>Try</SourceLine>
          <SourceLine>MyDB.ExecuteSQL(sql, myStatePopup.RowTagAt(myStatePopup.SelectedRowIndex).IntegerValue, uid.Text)</SourceLine>
          <SourceLine>Catch error As DatabaseException</SourceLine>
          <SourceLine>MessageBox( "DB Error " + error.Message)</SourceLine>
          <SourceLine>End Try</SourceLine>
          <SourceLine/>
          <SourceLine>end if</SourceLine>
          <SourceLine/>
          <SourceLine>listUsers</SourceLine>
          <SourceLine>End Sub</SourceLine>

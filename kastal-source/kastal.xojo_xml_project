        <ItemName>SelectionChanged</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>1139056639</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub SelectionChanged(rows() As Integer)</SourceLine>
          <SourceLine>myStatePopup.Enabled=false</SourceLine>
          <SourceLine/>
          <SourceLine>if me.SelectedRowIndex&gt;=0 then</SourceLine>
          <SourceLine>EmailFld.Enabled=false</SourceLine>
          <SourceLine>PWFld.enabled=false</SourceLine>
          <SourceLine>SaveUserBtn.Enabled=true</SourceLine>
          <SourceLine>DeleteUsrBtn.enabled=true</SourceLine>
          <SourceLine/>
          <SourceLine>Var myState, i As Integer</SourceLine>
          <SourceLine/>
          <SourceLine/>
          <SourceLine>uID.Text=me.RowTagAt(UsersListbox.SelectedRowIndex).StringValue</SourceLine>
          <SourceLine>myState=me.CellTextAt(me.SelectedRowIndex, 1).ToInteger</SourceLine>
          <SourceLine/>
          <SourceLine>for i=0 to myStatePopup.RowCount-1</SourceLine>
          <SourceLine>if myStatePopup.RowTagAt(i) = myState then</SourceLine>
          <SourceLine>myStatePopup.SelectedRowIndex=i</SourceLine>
          <SourceLine>myStatePopup.Enabled=True</SourceLine>
          <SourceLine>end if</SourceLine>
          <SourceLine>next</SourceLine>
          <SourceLine/>
          <SourceLine>Var rs As RowSet</SourceLine>
          <SourceLine>Try</SourceLine>
          <SourceLine>rs = MyDB.SelectSQL("SELECT * FROM tblUsers WHERE userID = ?", UsersListbox.RowTagAt(UsersListbox.SelectedRowIndex).IntegerValue)</SourceLine>
          <SourceLine>For Each row As DatabaseRow In rs</SourceLine>
          <SourceLine>UserData.Text=row.Column("FirstName").StringValue+" "+row.Column("LastName").StringValue+EndOfLine+row.Column("Adr1").StringValue+EndOfLine+row.Column("Adr2").StringValue+EndOfLine+row.Column("PostalCode").StringValue+" "+row.Column("City").StringValue+EndOfLine+row.Column("Country").StringValue+EndOfLine+EndOfLine+"Email: "+row.Column("Email").StringValue+EndOfLine+"Tel: "+row.Column("Phone").StringValue</SourceLine>
          <SourceLine>Next</SourceLine>
          <SourceLine>rs.Close</SourceLine>
          <SourceLine>Catch error As DatabaseException</SourceLine>
          <SourceLine>MessageBox("Error: " + error.Message)</SourceLine>
          <SourceLine>End Try</SourceLine>
          <SourceLine/>
          <SourceLine/>
          <SourceLine>else</SourceLine>
          <SourceLine>DeleteUsrBtn.enabled=false</SourceLine>
          <SourceLine>SaveUserBtn.Enabled=false</SourceLine>
          <SourceLine>myStatePopup.SelectedRowIndex=-1</SourceLine>
          <SourceLine>EmailFld.Enabled=false</SourceLine>
          <SourceLine>PWFld.enabled=false</SourceLine>
          <SourceLine>end if</SourceLine>
          <SourceLine>End Sub</SourceLine>
        </ItemSource>
      </HookInstance>
    </ControlBehavior>

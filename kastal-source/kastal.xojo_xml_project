    <Method>
      <ItemName>ScanFolder</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>47636479</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub ScanFolder(theFolder as FolderItem)</SourceLine>
        <SourceLine>Dim sql, Band, Album, Title, Artist As  string</SourceLine>
        <SourceLine>Var tracknum, Year As integer</SourceLine>
        <SourceLine>dim f as folderitem</SourceLine>
        <SourceLine>'dim mediaFile As EKMediaFile</SourceLine>
        <SourceLine/>
        <SourceLine>Dim Items As Integer = theFolder.Count</SourceLine>
        <SourceLine>Dim theEncoding as TextEncoding </SourceLine>
        <SourceLine/>
        <SourceLine>for i as Integer=0 to Items-1</SourceLine>
        <SourceLine/>
        <SourceLine/>
        <SourceLine/>
        <SourceLine>f=theFolder.ChildAt(i)</SourceLine>
        <SourceLine>if f &lt;&gt; nil then</SourceLine>
        <SourceLine>if f.Exists then</SourceLine>
        <SourceLine>'SongCounter=SongCounter+1</SourceLine>
        <SourceLine>'LastSong=f.Name</SourceLine>
        <SourceLine>if f.IsFolder then</SourceLine>
        <SourceLine>ScanFolder(f)</SourceLine>
        <SourceLine>else</SourceLine>
        <SourceLine>Select Case f.Name.Right(4)</SourceLine>
        <SourceLine>Case ".mp3", ".m4a", ".m4u", ".aac"</SourceLine>
        <SourceLine/>
        <SourceLine>//Check if the file is already added</SourceLine>
        <SourceLine>Var rs As RowSet</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>rs = tMyDB.SelectSQL("SELECT TuneID FROM tblTunes WHERE Location = ?", f.NativePath)</SourceLine>
        <SourceLine>if rs.RowCount=0 then</SourceLine>
        <SourceLine/>
        <SourceLine/>
        <SourceLine/>
        <SourceLine/>
        <SourceLine>//Store tune data</SourceLine>
        <SourceLine>'Band=f.Parent.Parent.Name</SourceLine>
        <SourceLine>'Album=f.parent.name</SourceLine>
        <SourceLine>'Title=f.Name</SourceLine>
        <SourceLine>'tracknum=""</SourceLine>
        <SourceLine>'Year=""</SourceLine>
        <SourceLine/>
        <SourceLine/>
        <SourceLine/>
        <SourceLine>Try</SourceLine>
        <SourceLine>//Get ID3-tags, if exists update tune data</SourceLine>
        <SourceLine>mediaFile = New EKMediaFile(f, false)</SourceLine>
        <SourceLine/>
        <SourceLine/>
        <SourceLine>Title=mediaFile.ID3Tags.Lookup("Title", f.Name).StringValue//.DefineEncoding(Encodings.UTF16BE)</SourceLine>
        <SourceLine>theEncoding = Guessencoding(Title)</SourceLine>
        <SourceLine>Title=Title.DefineEncoding(theEncoding).ConvertEncoding(Encodings.UTF8)</SourceLine>
        <SourceLine/>
        <SourceLine/>
        <SourceLine>Band=mediaFile.ID3Tags.Lookup("Band", Artist).StringValue.DefineEncoding(theEncoding)</SourceLine>
        <SourceLine>if Band = "" then</SourceLine>
        <SourceLine>Band=mediaFile.ID3Tags.Lookup("Artist", f.Name).StringValue.DefineEncoding(theEncoding)</SourceLine>
        <SourceLine>end if</SourceLine>
        <SourceLine>theEncoding = Guessencoding(Band)</SourceLine>
        <SourceLine>Band=Band.DefineEncoding(theEncoding).ConvertEncoding(Encodings.UTF8)</SourceLine>
        <SourceLine/>
        <SourceLine>tracknum=mediaFile.ID3Tags.Lookup("tracknum", f.Name).StringValue.ToInteger//DefineEncoding(theEncoding)</SourceLine>
        <SourceLine/>
        <SourceLine>Album=mediaFile.ID3Tags.Lookup("Album", theFolder.Name).StringValue//.DefineEncoding(theEncoding)</SourceLine>
        <SourceLine>theEncoding = Guessencoding(Album)</SourceLine>
        <SourceLine>Album=Album.DefineEncoding(theEncoding).ConvertEncoding(Encodings.UTF8)</SourceLine>
        <SourceLine/>
        <SourceLine>Year=mediaFile.ID3Tags.Lookup("Year", "").StringValue.ToInteger//DefineEncoding(theEncoding)</SourceLine>
        <SourceLine/>
        <SourceLine>Catch err As OutOfMemoryException</SourceLine>
        <SourceLine>'theEncoding = Encodings.ASCII</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine/>
        <SourceLine>if Title.Bytes&gt;128 then //Check for overflow of binary data, tune ID3 titles are never more than 128 chars long</SourceLine>
        <SourceLine>theEncoding = Guessencoding(f.Name)</SourceLine>
        <SourceLine>Title=f.Name.DefineEncoding(theEncoding).ConvertEncoding(Encodings.UTF8)</SourceLine>
        <SourceLine>end if</SourceLine>
        <SourceLine/>
        <SourceLine>Title=GetCleanUTFText(Title)</SourceLine>
        <SourceLine>Band=GetCleanUTFText(Band)</SourceLine>
        <SourceLine>Album=GetCleanUTFText(Album)</SourceLine>
        <SourceLine/>
        <SourceLine>//Fallback if ID3 tag extraction failed, we presume file path of .../band/album/tune.xxx</SourceLine>
        <SourceLine>if Title = "" then</SourceLine>
        <SourceLine>theEncoding = Guessencoding(f.Name)</SourceLine>
        <SourceLine>Title=f.Name.DefineEncoding(theEncoding).ConvertEncoding(Encodings.UTF8)</SourceLine>
        <SourceLine>end if</SourceLine>
        <SourceLine>if Album = "" or Album = " " then</SourceLine>
        <SourceLine>Album=f.Parent.Name.DefineEncoding(theEncoding)</SourceLine>
        <SourceLine>end if</SourceLine>
        <SourceLine>if Band = "" then</SourceLine>
        <SourceLine>theEncoding = Guessencoding(f.Name)</SourceLine>
        <SourceLine>Band=f.Parent.Parent.Name.DefineEncoding(theEncoding).ConvertEncoding(Encodings.UTF8)</SourceLine>
        <SourceLine>end if</SourceLine>
        <SourceLine/>
        <SourceLine/>
        <SourceLine>if Title&lt;&gt;"" then</SourceLine>
        <SourceLine>//Update DB with data</SourceLine>
        <SourceLine>sql = "INSERT INTO tblTunes (Band, Album, Title, tracknum, Year, Location) VALUES(?, ?, ?, ?, ?, ?)"</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>tMyDB.ExecuteSQL(sql, Band, Album, Title, tracknum.ToString, Year.ToString, f.NativePath)</SourceLine>
        <SourceLine>'rowID = MyDB.LastRowID</SourceLine>
        <SourceLine>Catch error As DatabaseException</SourceLine>
        <SourceLine>'MessageBox("DB Error: " + error.Message)</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>end if</SourceLine>
        <SourceLine/>
        <SourceLine>end if</SourceLine>
        <SourceLine>end Try</SourceLine>
        <SourceLine/>
        <SourceLine>end Select</SourceLine>
        <SourceLine>end if</SourceLine>
        <SourceLine>end if</SourceLine>
        <SourceLine>end if</SourceLine>
        <SourceLine>next</SourceLine>
        <SourceLine/>
        <SourceLine/>
        <SourceLine/>
        <SourceLine>Exception</SourceLine>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
